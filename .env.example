# BreachLoop — environment template
#
# EVERY VARIABLE BELOW IS OPTIONAL. A clean `npm install && npm run dev` (or a
# zero-config Vercel deploy) boots the SOC console, the API routes, the scenario
# pack and the digital twin with no .env file at all. Copy to `.env.local` only
# when you want to change a default.

# ── API base URL (dynamic resolver in lib/api/baseUrl.ts) ───────────────────
# Unset is the correct default: the app is same-origin, so requests go to the
# relative path /api. Set only if you host the API somewhere else.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ── Local dev port (used by `npm run dev` / `npm run start`) ────────────────
# PORT=3000

# ── Scenario pack ───────────────────────────────────────────────────────────
# Directory of scenario JSON. Defaults to ./scenarios. The bundled pack is
# always used as a fallback, so a wrong value can never empty the console.
# BREACHLOOP_SCENARIOS_DIR=/absolute/path/to/scenarios

# ── Incident run store ──────────────────────────────────────────────────────
# File used to persist runs between requests. Optional: the store is in-memory
# first and silently degrades when the filesystem is read-only (Vercel
# serverless), which is exactly the condition that used to throw HTTP 500.
# BREACHLOOP_DB_PATH=/tmp/breachloop-runs.json

# Set to 1 to skip file persistence entirely (pure in-memory).
# BREACHLOOP_DISABLE_PERSISTENCE=0

# ── Analyst provider ────────────────────────────────────────────────────────
# `anthropic` is opt-in. Without a key the API answers 200 in deterministic
# mode and tags the payload, instead of throwing.
# BREACHLOOP_PROVIDER=deterministic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Misc ────────────────────────────────────────────────────────────────────
# Extra CORS origin for a separately hosted frontend (same-origin needs none).
# BREACHLOOP_API_CORS_ORIGIN=
# BREACHLOOP_DEBUG=1
