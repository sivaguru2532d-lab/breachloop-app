{
  "name": "breachloop",
  "version": "2.0.0",
  "private": true,
  "description": "AI-Assisted Cloud Incident-Response Simulator \u2014 unified Next.js app (UI + API, no external backend)",
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=90000 tests/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm test",
    "reference:install": "python3 -m pip install -r backend/requirements.txt",
    "reference:serve": "cd backend && python3 -m breachloop serve",
    "reference:test": "cd backend && python3 -m pytest -q",
    "dev:with-reference": "concurrently -n next,reference -c cyan,magenta \"next dev -H 0.0.0.0 -p 3000\" \"python3 -m uvicorn breachloop.api.app:create_app --factory --port 8000 --app-dir backend\"",
    "test:e2e": "npm run build && node --test --test-timeout=90000 tests/*.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "15.5.27",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "security",
    "incident-response",
    "cloud-security",
    "digital-twin",
    "cloudtrail",
    "soc-console",
    "nextjs",
    "vercel"
  ]
}
