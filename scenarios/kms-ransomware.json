{
  "id": "kms-ransomware",
  "name": "KMS Key Deletion Schedule",
  "description": "A hijacked automation role schedules deletion of the customer data encryption key, holding the account hostage.",
  "scenario_type": "attack",
  "events": [
    {
      "event_id": "evt-ops-assume",
      "event_time": "2026-04-11T01:05:00Z",
      "action": "sts:AssumeRole",
      "service": "sts",
      "actor_arn": "arn:aws:iam::123456789012:user/break-glass",
      "target_arn": "arn:aws:iam::123456789012:role/OpsAutomationRole",
      "is_supported": true,
      "raw_evidence": {
        "eventName": "AssumeRole",
        "sourceIPAddress": "203.0.113.99",
        "userIdentity": {
          "type": "IAMUser",
          "principalId": "AIDABG01",
          "arn": "arn:aws:iam::123456789012:user/break-glass",
          "userName": "break-glass"
        }
      }
    },
    {
      "event_id": "evt-sched-del",
      "event_time": "2026-04-11T01:06:12Z",
      "action": "kms:ScheduleKeyDeletion",
      "service": "kms",
      "actor_arn": "arn:aws:iam::123456789012:role/OpsAutomationRole",
      "target_arn": "arn:aws:kms:us-east-1:123456789012:key/1f0c9a1d-2b3e-4a5c-8d7e-9a0b1c2d3e4f",
      "is_supported": true,
      "raw_evidence": {
        "eventName": "ScheduleKeyDeletion",
        "requestParameters": {
          "KeyId": "arn:aws:kms:us-east-1:123456789012:key/1f0c9a1d-2b3e-4a5c-8d7e-9a0b1c2d3e4f",
          "PendingWindowInDays": 7
        }
      }
    }
  ],
  "principals": [
    {
      "id": "principal-break-glass",
      "name": "break-glass",
      "type": "Principal",
      "arn": "arn:aws:iam::123456789012:user/break-glass",
      "is_compromised": true
    }
  ],
  "roles": [
    {
      "id": "role-opsautomationrole",
      "name": "OpsAutomationRole",
      "type": "Role",
      "arn": "arn:aws:iam::123456789012:role/OpsAutomationRole",
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": [
                "arn:aws:iam::123456789012:user/break-glass"
              ]
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "attached_policies": []
    }
  ],
  "resources": [
    {
      "id": "resource-customer data cmk",
      "name": "Customer Data CMK",
      "type": "KMSKey",
      "arn": "arn:aws:kms:us-east-1:123456789012:key/1f0c9a1d-2b3e-4a5c-8d7e-9a0b1c2d3e4f",
      "is_sensitive": true,
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": []
      }
    },
    {
      "id": "resource-backup bucket",
      "name": "Backup Bucket",
      "type": "S3Bucket",
      "arn": "arn:aws:s3:::acme-backups",
      "is_sensitive": false,
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": []
      }
    }
  ],
  "workloads": [],
  "workflows": [
    {
      "id": "backup-copy",
      "name": "Encrypted Backup Copy",
      "description": "Copies encrypted nightly backups into the backup bucket.",
      "principal_arn": "arn:aws:iam::123456789012:role/OpsAutomationRole",
      "required_action": "s3:PutObject",
      "target_resource_arn": "arn:aws:s3:::acme-backups",
      "criticality": "High"
    }
  ],
  "candidate_remediations": [
    {
      "id": "fix-broad-01",
      "title": "Revoke all active sessions on the role",
      "remediation_type": "revoke_role_sessions",
      "target_arn": "arn:aws:iam::123456789012:role/OpsAutomationRole",
      "parameters": {
        "role_arn": "arn:aws:iam::123456789012:role/OpsAutomationRole"
      },
      "description": "Deny every principal access to the role. Stops the attacker, and stops the encrypted backup copy job.",
      "is_broad": true
    },
    {
      "id": "fix-narrow-01",
      "title": "Deny key deletion scheduling for the ops role",
      "remediation_type": "attach_inline_deny",
      "target_arn": "arn:aws:kms:us-east-1:123456789012:key/1f0c9a1d-2b3e-4a5c-8d7e-9a0b1c2d3e4f",
      "parameters": {
        "denied_principal_arn": "arn:aws:iam::123456789012:role/OpsAutomationRole",
        "denied_action": "kms:ScheduleKeyDeletion",
        "denied_resource_arn": "arn:aws:kms:us-east-1:123456789012:key/1f0c9a1d-2b3e-4a5c-8d7e-9a0b1c2d3e4f"
      },
      "description": "Inline deny on kms:ScheduleKeyDeletion for this key only; backup workflows keep running.",
      "is_broad": false
    }
  ],
  "ground_truth": {
    "expected_broad_remediation_status": "rejected",
    "expected_narrow_remediation_status": "verified",
    "expected_broad_remediation_broken_workflow": "backup-copy"
  }
}
