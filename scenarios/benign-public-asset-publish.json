  "candidate_remediations": [
    {
      "id": "fix-broad-01",
      "title": "Revoke all active sessions on the role",
      "remediation_type": "revoke_role_sessions",
      "target_arn": "arn:aws:iam::123456789012:role/StaticPublisherRole",
      "parameters": {
        "role_arn": "arn:aws:iam::123456789012:role/StaticPublisherRole"
      },
      "description": "Deny every principal access to the role. Stops the attacker, while breaking the CDN publish job for no security gain.",
      "is_broad": true
    },
    {
      "id": "fix-narrow-01",
      "title": "Deny bucket deletion for the publisher role",
      "remediation_type": "remove_resource_permission",
      "target_arn": "arn:aws:s3:::acme-public-assets",
      "parameters": {
        "denied_principal_arn": "arn:aws:iam::123456789012:role/StaticPublisherRole",
        "denied_action": "s3:DeleteBucket",
        "denied_resource_arn": "arn:aws:s3:::acme-public-assets"
      },
      "description": "Cheap guardrail that does not interfere with publishing.",
