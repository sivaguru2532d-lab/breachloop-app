      "arn": "arn:aws:s3:::acme-web-static",
      "is_sensitive": false,
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": []
      }
    },
    {
      "id": "resource-batch output bucket",
      "name": "Batch Output Bucket",
      "type": "S3Bucket",
      "arn": "arn:aws:s3:::acme-batch-output",
      "is_sensitive": false,
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": []
      }
    }
  ],
  "workloads": [
    {
      "id": "workload-web static sync",
      "name": "Web Static Sync",
      "type": "Lambda",
      "arn": "arn:aws:lambda:us-east-1:123456789012:function:static-sync",
      "execution_role_arn": "arn:aws:iam::123456789012:role/WebAppRole"
    }
  ],
  "workflows": [
    {
      "id": "static-sync",
      "name": "Web Static Asset Sync",
      "description": "Syncs built front-end assets to the public static bucket.",
      "principal_arn": "arn:aws:iam::123456789012:role/WebAppRole",
      "required_action": "s3:PutObject",
      "target_resource_arn": "arn:aws:s3:::acme-web-static",
      "criticality": "High"
    },
    {
      "id": "payroll-import",
      "name": "Payroll Import Job",
      "description": "Nightly payroll ledger import run by the batch role.",
      "principal_arn": "arn:aws:iam::123456789012:role/BatchRole",
      "required_action": "s3:PutObject",
      "target_resource_arn": "arn:aws:s3:::acme-batch-output",
      "criticality": "High"
    }
  ],
  "candidate_remediations": [
    {
      "id": "fix-broad-01",
      "title": "Revoke all active sessions on the role",
      "remediation_type": "revoke_role_sessions",
      "target_arn": "arn:aws:iam::123456789012:role/BatchRole",
      "parameters": {
        "role_arn": "arn:aws:iam::123456789012:role/BatchRole"
      },
      "description": "Deny every principal access to the role. Stops the attacker, and breaks the nightly payroll import.",
      "is_broad": true
    },
    {
      "id": "fix-narrow-01",
      "title": "Deny object reads on the payroll bucket",
      "remediation_type": "remove_resource_permission",
      "target_arn": "arn:aws:s3:::acme-payroll",
      "parameters": {
        "denied_principal_arn": "arn:aws:iam::123456789012:role/BatchRole",
        "denied_action": "s3:GetObject",
        "denied_resource_arn": "arn:aws:s3:::acme-payroll"
      },
      "description": "Removes read access for BatchRole on the payroll bucket only; the import job writes elsewhere and stays live.",
      "is_broad": false
    }
  ],
  "ground_truth": {
    "expected_broad_remediation_status": "rejected",
    "expected_narrow_remediation_status": "verified",
    "expected_broad_remediation_broken_workflow": "payroll-import"
  }
}
