        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": [
                "arn:aws:iam::123456789012:role/WebAppRole"
              ]
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "attached_policies": []
    },
    {
      "id": "role-batchrole",
      "name": "BatchRole",
      "type": "Role",
      "arn": "arn:aws:iam::123456789012:role/BatchRole",
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": [
                "arn:aws:iam::123456789012:role/WebAppRole"
              ]
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "attached_policies": []
    }
  ],
  "resources": [
    {
      "id": "resource-payroll bucket",
      "name": "Payroll Bucket",
      "type": "S3Bucket",
      "arn": "arn:aws:s3:::acme-payroll",
      "is_sensitive": true,
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": []
      }
    },
    {
      "id": "resource-web static bucket",
      "name": "Web Static Bucket",
