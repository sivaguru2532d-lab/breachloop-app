{
  "id": "instance-profile-ssrf",
  "name": "SSRF to Instance Profile Escalation",
  "description": "An SSRF in the public web app steals its instance profile credentials, then escalates into the batch role to read payroll data.",
  "scenario_type": "attack",
  "events": [
    {
      "event_id": "evt-web-role",
      "event_time": "2026-07-19T11:02:33Z",
      "action": "sts:AssumeRole",
      "service": "sts",
      "actor_arn": "arn:aws:iam::123456789012:role/WebAppRole",
      "target_arn": "arn:aws:iam::123456789012:role/BatchRole",
      "is_supported": true,
      "raw_evidence": {
        "eventName": "AssumeRole",
        "sourceIPAddress": "192.0.2.10",
        "requestParameters": {
          "RoleArn": "arn:aws:iam::123456789012:role/BatchRole"
        }
      }
    },
    {
      "event_id": "evt-payroll-get",
      "event_time": "2026-07-19T11:04:02Z",
      "action": "s3:GetObject",
      "service": "s3",
      "actor_arn": "arn:aws:iam::123456789012:role/BatchRole",
      "target_arn": "arn:aws:s3:::acme-payroll",
      "is_supported": true,
      "raw_evidence": {
        "eventName": "GetObject",
        "requestParameters": {
          "bucketName": "acme-payroll"
        }
      }
    },
    {
      "event_id": "evt-unknown",
      "event_time": "2026-07-19T11:04:30Z",
      "action": "unsupported:SomeNewApi",
      "service": "unknown",
      "actor_arn": "arn:aws:iam::123456789012:role/BatchRole",
      "target_arn": null,
      "is_supported": false,
      "raw_evidence": {
        "eventName": "SomeNewApi"
      }
    }
  ],
  "principals": [
    {
      "id": "principal-webapp instance",
      "name": "WebApp Instance",
      "type": "Principal",
      "arn": "arn:aws:iam::123456789012:role/WebAppRole",
      "is_compromised": true
    }
  ],
  "roles": [
    {
      "id": "role-webapprole",
      "name": "WebAppRole",
      "type": "Role",
      "arn": "arn:aws:iam::123456789012:role/WebAppRole",
      "trust_policy": {
