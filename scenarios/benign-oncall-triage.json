      "id": "fix-narrow-01",
      "title": "Deny diagnostic deletion for the triage role",
      "remediation_type": "remove_resource_permission",
      "target_arn": "arn:aws:s3:::acme-diagnostics",
      "parameters": {
        "denied_principal_arn": "arn:aws:iam::123456789012:role/OnCallTriageRole",
        "denied_action": "s3:DeleteObject",
        "denied_resource_arn": "arn:aws:s3:::acme-diagnostics"
      },
      "description": "Reads stay available while destructive deletes are blocked.",
