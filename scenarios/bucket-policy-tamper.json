{
  "id": "bucket-policy-tamper",
  "name": "Bucket Policy Made Public",
  "description": "The document service role rewrites its own bucket policy to grant anonymous reads on a bucket that holds legal holds.",
  "scenario_type": "attack",
  "events": [
    {
      "event_id": "evt-docs-assume",
      "event_time": "2026-06-01T09:30:00Z",
      "action": "sts:AssumeRole",
      "service": "sts",
      "actor_arn": "arn:aws:iam::123456789012:user/svc-docs",
      "target_arn": "arn:aws:iam::123456789012:role/DocsServiceRole",
      "is_supported": true,
      "raw_evidence": {
        "eventName": "AssumeRole",
        "userIdentity": {
          "type": "IAMUser",
          "principalId": "AIDASD01",
          "arn": "arn:aws:iam::123456789012:user/svc-docs",
          "userName": "svc-docs"
        }
      }
    },
    {
      "event_id": "evt-put-policy",
      "event_time": "2026-06-01T09:31:14Z",
      "action": "s3:PutBucketPolicy",
      "service": "s3",
      "actor_arn": "arn:aws:iam::123456789012:role/DocsServiceRole",
      "target_arn": "arn:aws:s3:::acme-legal-holds",
      "is_supported": true,
      "raw_evidence": {
        "eventName": "PutBucketPolicy",
        "requestParameters": {
          "bucketName": "acme-legal-holds",
          "policy": {
            "Statement": [
              {
                "Effect": "Allow",
                "Principal": "*",
                "Action": "s3:GetObject"
              }
            ]
          }
        }
      }
    },
    {
      "event_id": "evt-denied",
      "event_time": "2026-06-01T09:31:55Z",
      "action": "s3:PutObject",
      "service": "s3",
      "actor_arn": "arn:aws:iam::123456789012:role/DocsServiceRole",
      "target_arn": "arn:aws:s3:::acme-legal-holds",
      "is_supported": false,
      "raw_evidence": {
        "eventName": "PutObject",
        "errorCode": "AccessDenied",
        "errorMessage": "Access Denied"
      }
    }
  ],
  "principals": [
    {
      "id": "principal-svc-docs",
      "name": "svc-docs",
      "type": "Principal",
      "arn": "arn:aws:iam::123456789012:user/svc-docs",
      "is_compromised": true
    }
  ],
  "roles": [
    {
      "id": "role-docsservicerole",
      "name": "DocsServiceRole",
      "type": "Role",
      "arn": "arn:aws:iam::123456789012:role/DocsServiceRole",
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": [
                "arn:aws:iam::123456789012:user/svc-docs"
              ]
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "attached_policies": []
    }
  ],
  "resources": [
    {
      "id": "resource-legal holds bucket",
      "name": "Legal Holds Bucket",
      "type": "S3Bucket",
      "arn": "arn:aws:s3:::acme-legal-holds",
      "is_sensitive": true,
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": []
      }
    },
    {
      "id": "resource-public assets bucket",
      "name": "Public Assets Bucket",
      "type": "S3Bucket",
      "arn": "arn:aws:s3:::acme-public-assets",
      "is_sensitive": false,
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": []
      }
    }
  ],
  "workloads": [
    {
      "id": "workload-docs renderer",
      "name": "Docs Renderer",
      "type": "Lambda",
      "arn": "arn:aws:lambda:us-east-1:123456789012:function:docs-render",
      "execution_role_arn": "arn:aws:iam::123456789012:role/DocsServiceRole"
    }
  ],
  "workflows": [
    {
      "id": "docs-render",
      "name": "Document Rendering",
      "description": "Renders customer documents into the public asset bucket.",
      "principal_arn": "arn:aws:iam::123456789012:role/DocsServiceRole",
      "required_action": "s3:PutObject",
      "target_resource_arn": "arn:aws:s3:::acme-public-assets",
      "criticality": "High"
    }
  ],
  "candidate_remediations": [
    {
      "id": "fix-broad-01",
      "title": "Revoke all active sessions on the role",
      "remediation_type": "revoke_role_sessions",
      "target_arn": "arn:aws:iam::123456789012:role/DocsServiceRole",
      "parameters": {
        "role_arn": "arn:aws:iam::123456789012:role/DocsServiceRole"
      },
      "description": "Deny every principal access to the role. Stops the attacker, which also halts all customer document rendering.",
      "is_broad": true
    },
    {
      "id": "fix-narrow-01",
      "title": "Block bucket policy writes on the legal holds bucket",
      "remediation_type": "remove_resource_permission",
      "target_arn": "arn:aws:s3:::acme-legal-holds",
      "parameters": {
        "denied_principal_arn": "arn:aws:iam::123456789012:role/DocsServiceRole",
        "denied_action": "s3:PutBucketPolicy",
        "denied_resource_arn": "arn:aws:s3:::acme-legal-holds"
      },
      "description": "Denies s3:PutBucketPolicy for this bucket only, so rendering into the public bucket continues.",
      "is_broad": false
    }
  ],
  "ground_truth": {
    "expected_broad_remediation_status": "rejected",
    "expected_narrow_remediation_status": "verified",
    "expected_broad_remediation_broken_workflow": "docs-render"
  }
}
