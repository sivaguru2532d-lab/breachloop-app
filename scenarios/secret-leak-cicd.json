{
  "id": "secret-leak-cicd",
  "name": "CI Runner to Production Secrets",
  "description": "A poisoned pull request exfiltrates a builder token, then chains two role assumptions to reach production database credentials.",
  "scenario_type": "attack",
  "events": [
    {
      "event_id": "evt-build-assume",
      "event_time": "2026-05-06T14:22:01Z",
      "action": "sts:AssumeRole",
      "service": "sts",
      "actor_arn": "arn:aws:iam::123456789012:user/github-runner",
      "target_arn": "arn:aws:iam::123456789012:role/CIBuilderRole",
      "is_supported": true,
      "raw_evidence": {
        "eventName": "AssumeRole",
        "sourceIPAddress": "198.51.100.24",
        "userIdentity": {
          "type": "IAMUser",
          "principalId": "AIDAGH01",
          "arn": "arn:aws:iam::123456789012:user/github-runner",
          "userName": "github-runner"
        }
      }
    },
    {
      "event_id": "evt-deploy-assume",
      "event_time": "2026-05-06T14:23:12Z",
      "action": "sts:AssumeRole",
      "service": "sts",
      "actor_arn": "arn:aws:iam::123456789012:role/CIBuilderRole",
      "target_arn": "arn:aws:iam::123456789012:role/DeployRole",
      "is_supported": true,
      "raw_evidence": {
        "eventName": "AssumeRole",
        "requestParameters": {
          "RoleArn": "arn:aws:iam::123456789012:role/DeployRole"
        }
      }
    },
    {
      "event_id": "evt-secret-get",
      "event_time": "2026-05-06T14:24:40Z",
      "action": "secretsmanager:GetSecretValue",
      "service": "secretsmanager",
      "actor_arn": "arn:aws:iam::123456789012:role/DeployRole",
      "target_arn": "arn:aws:secretsmanager:us-east-1:123456789012:secret:prod/database",
      "is_supported": true,
      "raw_evidence": {
        "eventName": "GetSecretValue",
        "requestParameters": {
          "SecretId": "prod/database"
        }
      }
    }
  ],
  "principals": [
    {
      "id": "principal-github-runner",
      "name": "github-runner",
      "type": "Principal",
      "arn": "arn:aws:iam::123456789012:user/github-runner",
      "is_compromised": true
    }
  ],
  "roles": [
    {
      "id": "role-cibuilderrole",
      "name": "CIBuilderRole",
      "type": "Role",
      "arn": "arn:aws:iam::123456789012:role/CIBuilderRole",
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": [
                "arn:aws:iam::123456789012:user/github-runner"
              ]
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "attached_policies": []
    },
    {
      "id": "role-deployrole",
      "name": "DeployRole",
      "type": "Role",
      "arn": "arn:aws:iam::123456789012:role/DeployRole",
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": [
                "arn:aws:iam::123456789012:role/CIBuilderRole"
              ]
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "attached_policies": []
    }
  ],
  "resources": [
    {
      "id": "resource-prod database secret",
      "name": "Prod Database Secret",
      "type": "SecretsManager",
      "arn": "arn:aws:secretsmanager:us-east-1:123456789012:secret:prod/database",
      "is_sensitive": true,
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": []
      }
    },
    {
      "id": "resource-release artifacts bucket",
      "name": "Release Artifacts Bucket",
      "type": "S3Bucket",
      "arn": "arn:aws:s3:::acme-release-artifacts",
      "is_sensitive": false,
      "resource_policy": {
        "Version": "2012-10-17",
        "Statement": []
      }
    }
  ],
  "workloads": [
    {
      "id": "workload-deploy function",
      "name": "Deploy Function",
      "type": "Lambda",
      "arn": "arn:aws:lambda:us-east-1:123456789012:function:deploy",
      "execution_role_arn": "arn:aws:iam::123456789012:role/DeployRole"
    }
  ],
  "workflows": [
    {
      "id": "deploy-publish",
      "name": "Deploy Artifact Fetch",
      "description": "Fetches signed release artifacts as part of every production deploy.",
      "principal_arn": "arn:aws:iam::123456789012:role/DeployRole",
      "required_action": "s3:GetObject",
      "target_resource_arn": "arn:aws:s3:::acme-release-artifacts",
      "criticality": "High"
    }
  ],
  "candidate_remediations": [
    {
      "id": "fix-broad-01",
      "title": "Revoke all active sessions on the role",
      "remediation_type": "revoke_role_sessions",
      "target_arn": "arn:aws:iam::123456789012:role/DeployRole",
      "parameters": {
        "role_arn": "arn:aws:iam::123456789012:role/DeployRole"
      },
      "description": "Deny every principal access to the role. Stops the attacker, but also blocks the deploy path that fetches release artifacts.",
      "is_broad": true
    },
    {
      "id": "fix-narrow-01",
      "title": "Deny production secret reads to the deploy role",
      "remediation_type": "remove_resource_permission",
      "target_arn": "arn:aws:secretsmanager:us-east-1:123456789012:secret:prod/database",
      "parameters": {
        "denied_principal_arn": "arn:aws:iam::123456789012:role/DeployRole",
        "denied_action": "secretsmanager:GetSecretValue",
        "denied_resource_arn": "arn:aws:secretsmanager:us-east-1:123456789012:secret:prod/database"
      },
      "description": "Denies only GetSecretValue on prod/database for DeployRole; the artifact fetch path is preserved.",
      "is_broad": false
    }
  ],
  "ground_truth": {
    "expected_broad_remediation_status": "rejected",
    "expected_narrow_remediation_status": "verified",
    "expected_broad_remediation_broken_workflow": "deploy-publish"
  }
}
